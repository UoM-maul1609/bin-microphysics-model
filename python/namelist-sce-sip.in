 &run_vars
    !> NetCDF output file written by the model.
	outputfile = '/tmp/output.nc',
    !> Total model integration time [s].
	runtime=7200.,
    !> Nominal model/microphysics timestep [s].
	dt=10.,
    !> Initial parcel/chamber temperature [K] when not taken from the sounding.
	tinit=244,
    !> Initial parcel/chamber pressure [Pa] when not taken from the sounding.
	pinit=90000,
    !> Initial parcel relative humidity as a fraction (e.g. 0.95 = 95%); overrides sounding RH initially.
	rhinit=0.95,
    !> Legacy microphysics flag retained for compatibility; it currently does not bypass the BMM driver.
	microphysics_flag=1,
    !> Ice microphysics switch: 0=liquid only; 1=enable ice bins/processes.
	ice_flag=1,
    !> Bin-remapping scheme: 0=full moving, 1=moving-centre, 2=Chen-Lamb mass-conserving remap.
	bin_scheme_flag=0,
    !> Water-activity/growth formulation: 0=Raoult/Koehler using molecular properties; 1=kappa-Koehler.
	kappa_flag=1/
&aerosol_setup
    !> Number of externally mixed aerosol modes.
    n_mode            = 2,
    !> Number of lognormal submodes used to describe each external aerosol mode.
    n_intern          = 4,
    !> Number of semivolatile organic volatility bins.
    n_sv              = 10,
    !> Semivolatile-organic switch used by the BMM volatility treatment.
    sv_flag           = 0,
    !> Number of aerosol/liquid size bins per external mode.
    n_bins            = 60,
    !> Number of nonvolatile aerosol composition components.
    n_comps           = 4/
&cloud_setup
    !> Number of cloud/hydrometeor bins added by standalone SCE.
    n_binsc                  =80,
    !> Standalone-SCE grid/bin-spacing factor.
    kfac                     =2,
    !> Minimum cloud-bin diameter for standalone SCE [m].
    dminc                    =3e-6,
    !> Maximum cloud-bin diameter for standalone SCE [m].
    dmaxc                    =10e-2/
&aerosol_spec
    !> Lognormal aerosol number concentration [m-3]; indexed by internal submode and external mode.
    n_aer1(1:3,1:2)        = 401.e6, 550.e6, 460.e6,
                             401.e6, 550.e6, 460.e6,
    !> Lognormal number-median dry diameter [m]; required positive for populated submodes.
    d_aer1(1:3,1:2)        = 1.3e-8   , 4.4e-8, 1.36e-7,
                            1.3e-8   , 4.4e-8, 1.36e-7,
    !> Natural-log geometric width ln(sigma_g); required positive for populated submodes.
    sig_aer1(1:3,1:2)      = 0.34   , 0.40, 0.44,
                             0.34   , 0.40, 0.44,
    !> Minimum dry aerosol-bin diameter [m].
    dmina              = 10.e-9,
    !> Maximum dry aerosol-bin diameter [m].
    dmaxa              = 3.e-6,
    !> Dry component mass fractions, indexed (external mode, component); each mode must sum to one.
    mass_frac_aer1(1:2,1:4) = 1., 1.,
 	                        0., 0.,
 	                        0., 0.,
 	                        0., 0.,	                        
    !> Component molar masses [kg mol-1].
    molw_core1(1:4)       = 132.14e-3,
 	                        132.14e-3,
 	                        132.14e-3,
 	                        132.14e-3,
    !> Component material densities [kg m-3].
    density_core1(1:4) =    1770.,
                            1770.,
 	                        1770., 
                            1770.,
    !> Effective van't Hoff/dissociation number used by the molecular Koehler treatment.
    nu_core1(1:4)      =    3,
                            3,  
                            3,  
                            3,                      
    !> Component hygroscopicity kappa used when kappa_flag=1.
    kappa_core1(1:4)      = 0.3,
                            0.2,  
                            0.3, 
                            0.3/
&cloud_spec
    !> Initial liquid-water content specified for standalone SCE populations [model units].
    lwc(1,1)                 =0.e-3,
    !> Mean liquid-drop diameter used to initialise standalone SCE populations [m unless case states otherwise].
    dbar(1,1)                =20.e-6,
    !> Initial ice-water content specified for standalone SCE populations [model units].
    iwc(1,1)                 =0.e-4,
    !> Mean ice-particle diameter used to initialise standalone SCE populations [m unless case states otherwise].
    dbari(1,1)                =100.e-6/

