&aerosol_spec
    !> Lognormal aerosol number concentration [kg-1]; indexed by internal submode and external mode.
    n_aer1(1:3,1:1)        = 7.73e8, 3.369e9, 9.1e7,
    !> Lognormal number-median dry diameter [m]; required positive for populated submodes.
    d_aer1(1:3,1:1)        = 79e-9   , 124e-9, 321e-9,
    !> Natural-log geometric width ln(sigma_g); required positive for populated submodes.
    sig_aer1(1:3,1:1)      = 0.30   , 0.47, 0.157,
    !> Lognormal aerosol number concentration [kg-1]; indexed by internal submode and external mode.
    n_aer1(1:3,2:2)        = 0e6, 0.e6, 0.001e6,
    !> Lognormal number-median dry diameter [m]; required positive for populated submodes.
    d_aer1(1:3,2:2)        = 100e-9   , 1e-9, 1.e-9,
    !> Natural-log geometric width ln(sigma_g); required positive for populated submodes.
    sig_aer1(1:3,2:2)      = 0.5   , 0.3, 0.3,
    !> Minimum dry aerosol-bin diameter [m].
    dmina              = 10.e-9,
    !> Maximum dry aerosol-bin diameter [m].
    dmaxa              = 3.e-6,
    !> Dry component mass fractions, indexed (external mode, component); each mode must sum to one.
    mass_frac_aer1(1:2,1:4) = 1., 0.,
 	                        0., 1.,
 	                        0., 0.,
 	                        0., 0.,                        
    !> Component molar masses [kg mol-1].
 	molw_core1(1:4)       = 58.44e-3,
 							132.14e-3,
 	                        132.14e-3,
 	                        132.14e-3,
    !> Component material densities [kg m-3].
 	density_core1(1:4) = 2165.,2165.,1770.,1770.,
    !> Effective van't Hoff/dissociation number used by the molecular Koehler treatment.
 	nu_core1(1:4)      = 2,
 	                        2,  
 	                        3,  
