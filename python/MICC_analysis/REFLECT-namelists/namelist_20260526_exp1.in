 &run_vars
    !> NetCDF output file written by the model.
	outputfile = '/tmp/output1.nc',
    !> Standalone-SCE namelist path used when SCE configuration is read separately.
	scefile = 'sce/namelist.in',
    !> Total model integration time [s].
	runtime=250.,
    !> Nominal model/microphysics timestep [s].
	dt=10.,
    !> Initial parcel height [m].
	zinit=900.,
    !> Initial parcel temperature perturbation [K].
	tpert=0.0,
    !> If true, initialise T and P from the sounding at zinit. Sounding RH is also read/interpolated,
    !> but the initial parcel RH is deliberately overwritten by rhinit.
	use_prof_for_tprh=.false.,
    !> Initial/constant parcel vertical velocity [m s-1], depending on updraft_type.
	winit=1.3,
    !> Secondary/peak updraft speed [m s-1] used by oscillatory updraft_type=3.
	winit2=0.5,
    !> Vertical displacement amplitude [m] used by oscillatory updraft_type=3.
	amplitude2=100.,
    !> Initial parcel/chamber temperature [K] when not taken from the sounding.
	tinit=280.,
    !> Initial parcel/chamber pressure [Pa] when not taken from the sounding.
	pinit=100000,
    !> Initial parcel relative humidity as a fraction (e.g. 0.95 = 95%); overrides sounding RH initially.
	rhinit=0.90,
    !> Legacy microphysics flag retained for compatibility; it currently does not bypass the BMM driver.
	microphysics_flag=1,
    !> Ice microphysics switch: 0=liquid only; 1=enable ice bins/processes.
	ice_flag=1,
    !> Bin-remapping scheme: 0=full moving, 1=moving-centre, 2=Chen-Lamb mass-conserving remap.
	bin_scheme_flag=0,
    !> Collision/SCE switch: 0=off, 1=SCE collection, 2=SCE plus secondary-ice processes.
	sce_flag = 0,
    !> Ventilation treatment selector used in diffusional growth calculations.
	vent_flag=1,
    !> Water-activity/growth formulation: 0=Raoult/Koehler using molecular properties; 1=kappa-Koehler.
	kappa_flag=1,
    !> Updraft forcing selector: 1=constant, 2=stop at t_thresh, 3=oscillatory, 4=model-specific profile.
	updraft_type=1,
    !> Threshold time/coordinate used by selected updraft forcing [s for time-based modes].
	t_thresh=2600.,
    !> Use an adiabatic environmental profile when .true.; false permits entrainment treatments.
 	adiabatic_prof=.true.,
    !> Discrete entrainment cadence: 0=inside solver; positive integer=every N model timesteps.
 	entrain_period=0,
    !> Time at which inhomogeneous mixing switches to homogeneous mixing [s].
 	thresh_to_start_hom_mix=3000.,
    !> Re-expose aerosol associated with evaporated liquid during inhomogeneous-mixing treatment when true.
 	release_aerosol=.true.,
    !> Full-moving residual-aerosol placement after complete evaporation/sublimation:
    !>   0 = DEFAULT: return equilibrated aerosol to the same numerical index the
    !>       liquid/ice particle evaporated from.
    !>   1 = insert by equilibrium water mass, partitioning number and all extensive
    !>       moments between the lower/upper bracketing current pivots.
    !> Modes conserve number, water mass, aerosol mass and prognostic moments.
    full_moving_release_mode=0,
    !> Entrains environmental aerosol with entrained air when .true.
 	entrain_aerosol=.true.,
    !> Entrain vertically when .true.; use lateral entrainment when .false.
 	vert_ent=.false.,
	!> Prescribed cloud-top height [m].
	!> The parcel simulation stops when its height reaches or exceeds z_ctop.
	!> Set <= 0 to disable the cloud-top stopping criterion.
	z_ctop=-1.,
    !> Specified entrainment rate [model convention, normally m-1 for vertical entrainment].
 	ent_rate=1.e-3,
    !> Number of sounding levels supplied in sounding_spec.
 	n_levels_s = 151,
    !> Thermal accommodation coefficient for liquid diffusional growth.
 	alpha_therm=1.0,
    !> Water-vapour condensation accommodation coefficient for liquid growth.
 	alpha_cond=1.0,
    !> Thermal accommodation coefficient for ice depositional growth.
 	alpha_therm_ice=1.0,
    !> Water-vapour deposition accommodation coefficient for ice growth.
 	alpha_dep=1.0,
    !> Enable Hallett-Mossop secondary-ice production when .true.
 	hm_flag=.false.,
    !> Collisional breakup selector: 0=off, 1=Vardiman treatment, 2=Phillips et al. treatment.
 	break_flag=0,
    !> Enable mode-1 freezing/collisional secondary-ice production.
 	mode1_flag=.false.,
    !> Enable mode-2 secondary-ice production.
 	mode2_flag=.false.,
	/
&chamber_options
    !> Number of chamber time-series samples in &chamber_spec.
    n_levels_c = 805,
    !> Independently force pressure from press_chamber(t).
    chamber_force_pressure = .true.,
    !> Independently force gas temperature from temp_chamber(t).
    chamber_force_temperature = .true.,
    !> Apply measured qtot_chamber tendency as an external water source/sink.
    !> Leave false when qtot is uncertain or is used only as a diagnostic.
    chamber_force_qtot = .true.,

    !> Boundary-layer interaction: 0=off, 1=homogeneous, 2=uniform extreme inhomogeneous.
    !> 3=D2-law-weighted extreme inhomogeneous: smaller activated droplets have a
    !> larger complete-evaporation fraction, proportional to m_w^(-2/3), capped at 1.
    chamber_bl_mix = 0,
    !> E-folding timescale for bulk-air recirculation through the wall BL [s].
    chamber_bl_tau = 60.0,
    !> BL temperature: 0=fixed offset from evolving gas T; 1=wall_temp_chamber(t).
    chamber_bl_temp_mode = 0,
    !> Used only for chamber_bl_temp_mode=0: T_BL - T_gas [K].
    chamber_bl_temp_offset = 0.0,
    !> Wall-vapour closure: 0=legacy saturation cap; 1=finite prognostic reservoir.
    chamber_bl_wall_water_mode = 0,
    !> Fractional equilibration during one BL wall encounter [0..1].
    chamber_wall_water_efficiency = 1.0,
    !> Initial physical wall-water reservoirs [kg].  Zero gives a dry/unfrosted wall.
    chamber_wall_liquid_water_init = 0.0,
    chamber_wall_ice_water_init = 0.0,

    !> Drone-fan blade loss: 0=off, 1=saturating sigmoid in current particle diameter.
    chamber_fan_loss = 0,
    !> Asymptotic large-particle first-order fan loss rate [s-1].
    chamber_fan_loss_kmax = 0.0,
    !> Diameter giving half kmax at chamber_fan_rpm_ref [m].
    chamber_fan_loss_d50_ref = 4.0e-6,
    !> Sigmoid sharpness: k/kmax = 1/[1+(D50/D)^exp].
    chamber_fan_loss_exp = 6.0,
    !> Fan speed for this run and reference speed defining d50_ref [rpm].
    chamber_fan_rpm = 25000.0,
    chamber_fan_rpm_ref = 25000.0,

    !> Non-gravitational deposition to smooth side walls and ceiling using
    !> Lai & Nazaroff (2000). The floor remains in the generic fallout scheme.
    chamber_wall_loss = 0,
    !> Wall friction velocity controlling turbulent deposition [m s-1].
    chamber_wall_ustar = 0.02,
    !> Cylindrical chamber geometry [m]. If specified in a chamber run,
    !> chamber_height is also used as the fallout depth V/A_floor.
    chamber_diameter = 0.0,
    chamber_height = 0.0
/
&aerosol_setup
    !> Number of externally mixed aerosol modes.
    n_mode            = 2,
    !> Number of lognormal submodes used to describe each external aerosol mode.
    n_intern          = 3,
    !> Number of semivolatile organic volatility bins.
    n_sv              = 10,
    !> Semivolatile-organic switch used by the BMM volatility treatment.
    sv_flag           = 0,
    !> Number of aerosol/liquid size bins per external mode.
    n_bins            = 240,
    !> Number of nonvolatile aerosol composition components.
    n_comps           = 4/
&sounding_spec  ! environmental sounding parameters
    !> Surface/reference pressure for sounding construction [Pa].
 	psurf=96500.,
    !> Surface/reference temperature for sounding construction [K].
 	tsurf=287.15,
    !> Sounding water/species mixing-ratio profile; first index is species, second is level.
	q_read(1,1:151)   = 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.961763e-03, 7.950102e-03, 7.930822e-03, 7.911553e-03, 7.892302e-03, 7.873067e-03, 7.853843e-03, 7.834631e-03, 7.815436e-03, 7.796259e-03, 7.777093e-03, 7.757940e-03, 7.738804e-03, 7.719680e-03, 7.700574e-03, 7.681475e-03, 7.662399e-03, 7.643335e-03, 7.624284e-03, 7.605246e-03, 7.586227e-03, 7.567220e-03, 7.548226e-03, 7.529251e-03, 7.510289e-03, 7.491346e-03, 7.472410e-03, 7.453494e-03, 7.434591e-03, 7.415708e-03, 7.396832e-03, 7.377976e-03, 7.359140e-03, 7.340312e-03, 7.321503e-03, 7.302704e-03, 7.283924e-03, 7.265164e-03, 7.246414e-03, 7.227683e-03, 7.208962e-03, 7.190261e-03, 7.171575e-03, 7.152904e-03, 7.134248e-03, 7.115612e-03, 7.096987e-03, 7.078378e-03, 7.059789e-03, 7.041210e-03, 7.022653e-03, 7.004111e-03, 6.985585e-03, 6.967070e-03, 6.948577e-03, 6.930099e-03, 6.911634e-03, 6.893189e-03, 6.874761e-03, 6.856349e-03, 6.837950e-03, 6.819572e-03, 6.801206e-03, 6.782857e-03, 6.764530e-03, 6.746216e-03, 6.727919e-03, 6.709639e-03, 6.691377e-03, 6.673127e-03, 6.654900e-03, 6.636686e-03, 6.618490e-03, 6.600312e-03, 6.582151e-03, 6.564009e-03, 6.545881e-03, 6.527775e-03, 6.509684e-03, 6.491606e-03, 6.473551e-03, 6.455511e-03, 6.437489e-03, 6.419482e-03, 6.401493e-03, 6.383524e-03, 6.365574e-03, 6.347638e-03, 6.329722e-03, 6.311826e-03, 6.293